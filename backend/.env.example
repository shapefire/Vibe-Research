# VibeResearch 后端可选配置。
# 本地自托管：全部留空即可（开箱开放）。公网部署：务必设置下面两项。
# 用法：复制为 backend/.env；uvicorn 启动 app 时会自动加载（不覆盖已 export 的变量）。

# ── 安全（公网部署必设） ─────────────────────────────────────────────
# CORS 白名单，逗号分隔。默认 "*"（放开，适合本地）。公网收紧成你的前端域名：
#   VR_ALLOW_ORIGINS=https://your-frontend-host
VR_ALLOW_ORIGINS=*

# 鉴权 key。一旦设置，所有 /api/*（除 /api/health）都需带 Authorization: Bearer <key>。
# 本地留空=开放；公网部署务必设一个强随机值（否则别人能读你的持仓、调你的后端）：
#   VR_API_KEY=$(openssl rand -hex 32)
VR_API_KEY=

# ── 数据源（可选） ───────────────────────────────────────────────────
# 行情/研报/公告/资金面等零 key 即用；仅 iwencai 语义搜索研报需要 key：
# IWENCAI_API_KEY=
# IWENCAI_BASE_URL=https://openapi.iwencai.com

# 代理：默认不用管。东财等国内数据源**默认直连**（自动绕开你的科学上网/Clash 代理，
# 因为国内财经站走翻墙代理反而会连不上，如 push2.eastmoney.com）。
# 仅当你的机器「只能靠代理才能出网」时，才设为 1 强制走系统代理：
# VR_DATA_PROXY=1

# ── 用户数据（可选） ─────────────────────────────────────────────────
# 数据根目录，默认 ~/.vibe-research/（持仓、研报、研究记录等均在此）
# VR_DATA_DIR=~/.vibe-research

# 研究记录数量上限（默认 500）
# VR_NOTES_MAX=500

# 单条研究记录正文上限（字节，默认 100KB）
# VR_NOTES_MAX_CONTENT_BYTES=102400

# ── 定时调度与每日摘要（06） ─────────────────────────────────────────
# 是否启动后台 scheduler（portfolio 刷新 + 每日摘要）
# VR_SCHEDULER_ENABLED=true
# 摘要 cron 时间（北京时间 HH:MM）
# VR_DIGEST_TIME=18:00
# VR_DIGEST_TIMEZONE=Asia/Shanghai
# 启用的 job 列表（逗号分隔；含 radar_cache_warm 时每小时预热资讯缓存）
# VR_JOBS=portfolio_refresh,daily_digest,radar_cache_warm
# Phase 2：定时 AI 复盘（需配置 LLM；默认 false 仅数据快照）
# VR_DIGEST_INCLUDE_LLM=false
# API 模式（GHA / 云端推荐）：
# VR_DIGEST_LLM_MODE=api
# VR_DIGEST_LLM_API_KEY=sk-...
# VR_DIGEST_LLM_BASE_URL=https://api.deepseek.com
# VR_DIGEST_LLM_MODEL=deepseek-chat
# 本机 CLI 模式（订阅接入，仅本地 uvicorn）：
# VR_DIGEST_LLM_MODE=cli
# VR_DIGEST_LLM_CLI=claude

# ── 推送通知（07 · 飞书 / 企业微信） ─────────────────────────────────
# 总开关（也可用 Settings 页写入 VR_DATA_DIR/notify.json，json 优先于 env）
# VR_NOTIFY_ENABLED=false
# VR_DASHBOARD_URL=http://127.0.0.1:5899/daily-review
# VR_NOTIFY_WECOM_ENABLED=false
# VR_NOTIFY_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
# VR_NOTIFY_FEISHU_ENABLED=false
# VR_NOTIFY_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/...
# 可选扩展白名单（默认已含企微/飞书官方域名）
# VR_NOTIFY_ALLOW_HOSTS=qyapi.weixin.qq.com,open.feishu.cn

# AI：无需在此配置。用户在网页「接入 AI」页填自己的 key（存本地浏览器），
#     或用订阅接入调本机已登录的 CLI（Claude Code / Codex / Qwen / Gemini / DeepSeek）。
