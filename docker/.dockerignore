# Docker build context = repo root (see docker/docker-compose.yml)
# 功能上等价于仓库根目录 .dockerignore（Docker 只读取 context 根下的文件）
.git
.github
.idea
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.venv
**/node_modules
frontend/dist
backend/.cache
backend/.env
**/.env
**/.env.*
docs/
*.md
!a-stock-data/**/*.md
!global-stock-data/**/*.md
